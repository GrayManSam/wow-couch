#!/usr/bin/python3 -I
"""xbox-headset - Xbox-style headset routing for a headset in the Xbox controller's 3.5mm jack.

Plug the headset into the controller: game + chat play on the TV AND the headset ("TV + Headset"
combined output), and the headset mic becomes the default input (Discord on "Default" follows).
Unplug: back to the outputs/input you had before. No TV: headset only (like an Xbox).

  xbox-headset watch                 the service (xbox-headset.service) - reacts live
  xbox-headset status                link (Bluetooth / USB-C / Wireless Adapter), driver, routing
  xbox-headset test                  beeps on the headset (+TV), then measures the mic for 3 s
  xbox-headset chat-only on|off      on = voice chat (Discord etc.) only in the headset, game on both
  xbox-headset mirror tv|never       tv = game also on the TV when one is connected (default)
  xbox-headset mute [on|off]         toggle (or set) the headset mic mute, with a sound cue
  xbox-headset auto on|off           turn the automatic switching on/off
  xbox-headset apply                 re-assert the routing (used by `audio wow`)
`audio headset ...` runs this. Stdlib only; pactl / pw-play / notify-send.

Jack audio needs the xone driver (USB-C or Xbox Wireless Adapter). Over Bluetooth the controller
never sends jack audio (Microsoft limitation): then nothing changes and you get one notification.
Test hooks: XBOX_HEADSET_MATCH (regex for the headset nodes), XBOX_HEADSET_CONF (config dir),
XBOX_HEADSET_TV (TV sink name instead of asking `audio wow tv`), XBOX_HEADSET_QUIET=1,
XBOX_HEADSET_NOTIFY=0.
"""
import ctypes
import json
import math
import os
import re
import signal
import subprocess
import sys
import tempfile
import time
import wave
from pathlib import Path

HOME = Path.home()
CONF = Path(os.environ.get("XBOX_HEADSET_CONF", HOME / ".config/xbox-headset"))
CFG = CONF / "config.json"
STATE = CONF / "state.json"
NOTIFIED = CONF / "notified"
AUDIO = HOME / ".local/bin/audio"
COMBO = "xbox_tv_headset"
COMBO_DESC = "TV + Headset"
EE_SINK = "easyeffects_sink"
EE_OUT = "com.github.wwmm.easyeffects.streamoutputs"
HS_RE = re.compile(os.environ.get("XBOX_HEADSET_MATCH",
                                  r"xone|xbox[ _-]?headset|microsoft xbox (wireless )?headset"), re.I)
CHAT_RE = re.compile(r"discord|webrtc|vesktop|armcord|webcord|teamspeak|mumble|zoom|skype|"
                     r"slack|signal|element|telegram", re.I)
CHAT_APPS_EE = ["WEBRTC VoiceEngine", "Discord", "discord", "Vesktop"]   # EasyEffects blocklist
SKIP_STREAM = re.compile(r"^(output\.(xbox_tv_headset|combine_sink)|ee_|easyeffects|audio-doctor|"
                         r"xbox-headset)", re.I)
DONGLE_PIDS = {"02e6", "02fe", "02f9", "091e"}
QUIET = os.environ.get("XBOX_HEADSET_QUIET") == "1"
DEFAULTS = {"auto": True, "chat_only": False, "mirror": "tv"}


# ---- small helpers -------------------------------------------------------------------
def sh(*cmd, timeout=10):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def ok(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, timeout=10).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def pj(what):
    try:
        return json.loads(sh("pactl", "-f", "json", "list", what) or "[]")
    except ValueError:
        return []


def load(path, default):
    try:
        return {**default, **json.loads(path.read_text())}
    except (OSError, ValueError):
        return dict(default)


def save(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=1) + "\n")
    tmp.replace(path)


def cfg():
    return load(CFG, DEFAULTS)


def log(msg):
    if not QUIET:
        print(msg, flush=True)


def notify(body, title="Headset"):
    log(f"notify: {title}: {body}")
    if QUIET or os.environ.get("XBOX_HEADSET_NOTIFY") == "0":
        return
    subprocess.Popen(["notify-send", "-a", "Headset", "-i", "audio-headset", title, body],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def gs_get(key):
    return sh("gsettings", "get", EE_OUT, key).strip()


def ee_running():
    return bool(sh("pgrep", "-x", "easyeffects").strip())


# ---- controller link (how the controller is connected) -----------------------------------
def usb_devices():
    out = []
    for d in Path("/sys/bus/usb/devices").glob("*"):
        try:
            if (d / "idVendor").read_text().strip() != "045e":
                continue
            pid = (d / "idProduct").read_text().strip()
        except OSError:
            continue
        prod = (d / "product").read_text().strip() if (d / "product").exists() else ""
        drivers = sorted({p.resolve().name for p in d.glob(f"{d.name}:*/driver")})
        out.append({"path": d.name, "pid": pid, "product": prod, "drivers": drivers,
                    "real": str(d.resolve())})
    return out


def input_pads():
    """Xbox gamepads from /proc/bus/input/devices: [(name, bus, sysfs path)]."""
    pads = []
    try:
        blocks = Path("/proc/bus/input/devices").read_text().split("\n\n")
    except OSError:
        return pads
    for b in blocks:
        name = re.search(r'^N: Name="(.*)"', b, re.M)
        bus = re.search(r"^I: Bus=(\w+)", b, re.M)
        sysfs = re.search(r"^S: Sysfs=(.*)$", b, re.M)
        if name and bus and "xbox" in name.group(1).lower() and "js" in b:
            pads.append((name.group(1), bus.group(1), "/sys" + (sysfs.group(1) if sysfs else "")))
    return pads


def xone_loaded():
    try:
        return any(l.startswith("xone_") for l in Path("/proc/modules").read_text().splitlines())
    except OSError:
        return False


def link():
    """{'kind': bluetooth|usb|dongle|none, 'audio': bool, 'why': str, ...}"""
    usb = usb_devices()
    dongles = [u for u in usb if u["pid"] in DONGLE_PIDS]
    wired = [u for u in usb if u["pid"] not in DONGLE_PIDS and "controller" in u["product"].lower()]
    pads = input_pads()
    bt = [p for p in pads if p[1] == "0005"]
    xone = xone_loaded()
    fix = "install the xone driver: sudo ~/Games/headset/install-xone.sh"
    if wired:
        drv = ",".join(wired[0]["drivers"]) or "none"
        good = any(d.startswith("xone") for d in wired[0]["drivers"])
        return {"kind": "usb", "audio": good, "driver": drv, "pid": wired[0]["pid"],
                "why": "USB-C, xone driver: jack audio works" if good else
                f"USB-C, driver {drv}: no jack audio — {fix}"}
    if dongles:
        good = xone and any(d.startswith("xone") for d in dongles[0]["drivers"])
        via = [p for p in pads if dongles[0]["real"] in os.path.realpath(p[2])]
        what = "controller connected" if via else "no controller paired/on yet"
        return {"kind": "dongle", "audio": good, "driver": ",".join(dongles[0]["drivers"]) or "none",
                "pid": dongles[0]["pid"],
                "why": f"Xbox Wireless Adapter ({what}): jack audio works" if good else
                f"Xbox Wireless Adapter without xone: no jack audio — {fix}"}
    if bt:
        return {"kind": "bluetooth", "audio": False, "driver": "hid-microsoft",
                "why": "Bluetooth: the controller's headset jack never carries audio over Bluetooth "
                       "(Microsoft limitation) — use a USB-C cable or the Xbox Wireless Adapter"}
    return {"kind": "none", "audio": False, "driver": "", "why": "no Xbox controller connected"}


# ---- PipeWire nodes ---------------------------------------------------------------------
def is_headset(node):
    p = node.get("properties", {})
    if p.get("device.class") == "monitor" or node.get("name", "").endswith(".monitor"):
        return False
    if node.get("name") == COMBO:
        return False
    hay = " ".join(str(p.get(k, "")) for k in (
        "node.name", "node.description", "device.description", "alsa.card_name",
        "alsa.long_card_name", "alsa.driver_name", "device.product.name", "api.alsa.card.name"))
    return bool(HS_RE.search(hay + " " + node.get("name", "") + " " + node.get("description", "")))


def headset_nodes(sinks=None, sources=None):
    sinks = pj("sinks") if sinks is None else sinks
    sources = pj("sources") if sources is None else sources
    hs = next((s["name"] for s in sinks if is_headset(s)), None)
    mic = next((s["name"] for s in sources if is_headset(s)), None)
    return hs, mic


def tv_sink(names):
    tv = os.environ.get("XBOX_HEADSET_TV")
    if tv is None and AUDIO.exists():
        out = sh(str(AUDIO), "wow", "tv", timeout=8).strip().splitlines()
        tv = out[-1] if out else ""
    return tv if tv in names else None


def real_sink(name, sinks):
    """Hardware sink behind `name` (resolves EasyEffects -> its output device)."""
    by = {s["name"]: s for s in sinks}
    def real(n):
        return n in by and n not in (EE_SINK, COMBO) and not is_headset(by[n]) \
            and bool(by[n].get("properties", {}).get("device.api"))
    if name and real(name):
        return name
    out = gs_get("output-device").strip("'")
    return out if real(out) else None


def move_sink_inputs(target, chat_target=None):
    sinks = {s["index"]: s["name"] for s in pj("sinks")}
    moved = 0
    ee = EE_SINK in sinks.values() and ee_running() and \
        sh("gsettings", "get", "com.github.wwmm.easyeffects", "process-all-outputs").strip() == "true"
    for si in pj("sink-inputs"):
        p = si.get("properties", {})
        tag = p.get("node.name", "") or p.get("application.name", "")
        if SKIP_STREAM.match(tag) or SKIP_STREAM.match(p.get("application.name", "") or "") \
                or p.get("node.dont-move") in ("true", True):
            continue
        cur = sinks.get(si.get("sink"))
        want = EE_SINK if ee else target       # EasyEffects plays to `target` (its output device)
        if chat_target and is_chat(p):
            want = chat_target
        elif cur == EE_SINK and ee:
            continue                    # already in the EasyEffects chain; leave it there
        if cur != want and ok("pactl", "move-sink-input", str(si["index"]), want):
            moved += 1
    return moved


def is_chat(p):
    hay = " ".join(str(p.get(k, "")) for k in ("application.name", "application.process.binary",
                                               "application.id", "node.name"))
    return bool(CHAT_RE.search(hay)) or p.get("media.role") in ("Communication", "phone")


# ---- combined output (TV + Headset) ----------------------------------------------------
COMBO_CONF = CONF / "combine.conf"


def combo_conf(members):
    rules = " ".join(f'{{ media.class = "Audio/Sink" node.name = "{m}" }}' for m in members)
    return f"""# written by xbox-headset — the "TV + Headset" combined output; regenerated each time
context.properties = {{ log.level = 1 }}
context.spa-libs = {{
    audio.convert.* = audioconvert/libspa-audioconvert
    support.*       = support/libspa-support
}}
context.modules = [
    {{ name = libpipewire-module-rt args = {{ nice.level = -11 }} flags = [ ifexists nofail ] }}
    {{ name = libpipewire-module-protocol-native }}
    {{ name = libpipewire-module-client-node }}
    {{ name = libpipewire-module-adapter }}
    {{ name = libpipewire-module-combine-stream
        args = {{
            combine.mode = sink
            node.name = "{COMBO}"
            node.description = "{COMBO_DESC}"
            combine.latency-compensate = true
            combine.props = {{ audio.position = [ FL FR ] }}
            stream.props = {{ node.dont-move = true resample.quality = 10 }}
            stream.rules = [
                {{ matches = [ {rules} ] actions = {{ create-stream = {{ }} }} }}
            ]
        }}
    }}
]
"""


class Combo:
    proc = None
    members = None

    @classmethod
    def up(cls, members):
        if cls.proc and cls.proc.poll() is None and cls.members == members:
            return True
        cls.down()
        kill_orphans()
        COMBO_CONF.parent.mkdir(parents=True, exist_ok=True)
        COMBO_CONF.write_text(combo_conf(members))

        def die_with_parent():
            try:
                ctypes.CDLL("libc.so.6").prctl(1, signal.SIGTERM)   # PR_SET_PDEATHSIG
            except OSError:
                pass
        cls.proc = subprocess.Popen(["pipewire", "-c", str(COMBO_CONF)], stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL, preexec_fn=die_with_parent)
        cls.members = members
        for _ in range(40):
            if any(s["name"] == COMBO for s in pj("sinks")):
                return True
            time.sleep(0.1)
        log("combined output did not appear")
        return False

    @classmethod
    def down(cls):
        if cls.proc and cls.proc.poll() is None:
            cls.proc.terminate()
            try:
                cls.proc.wait(3)
            except subprocess.TimeoutExpired:
                cls.proc.kill()
        cls.proc = cls.members = None


def kill_orphans():
    for pid in sh("pgrep", "-f", f"pipewire -c {COMBO_CONF}").split():
        if int(pid) != os.getpid():
            try:
                os.kill(int(pid), signal.SIGTERM)
            except OSError:
                pass


# ---- routing ------------------------------------------------------------------------------
def set_ee_blocklist(add):
    """chat-only: keep voice-chat apps out of EasyEffects (it would send them to the TV too)."""
    st = load(STATE, {})
    if add:
        if "ee_blocklist" not in st:
            st["ee_blocklist"] = gs_get("blocklist")
            save(STATE, st)
        cur = re.findall(r"'([^']*)'", gs_get("blocklist"))
        new = cur + [a for a in CHAT_APPS_EE if a not in cur]
        ok("gsettings", "set", EE_OUT, "blocklist", "[" + ", ".join(f"'{a}'" for a in new) + "]")
    elif "ee_blocklist" in st:
        ok("gsettings", "set", EE_OUT, "blocklist", st.pop("ee_blocklist"))
        save(STATE, st)


def engage(hs, mic, why="headset plugged in"):
    c = cfg()
    sinks = pj("sinks")
    names = {s["name"] for s in sinks}
    st = load(STATE, {})
    cur_sink = sh("pactl", "get-default-sink").strip()
    cur_src = sh("pactl", "get-default-source").strip()
    if not st.get("active"):
        st = {"active": True, "since": time.strftime("%F %T"),
              "sink": real_sink(cur_sink, sinks) or cur_sink,
              "source": cur_src if cur_src != mic else None,
              "ee_output": gs_get("output-device"), **{k: v for k, v in st.items()
                                                       if k == "ee_blocklist"}}
    elif cur_sink not in (COMBO, hs) and real_sink(cur_sink, sinks):
        st["sink"] = real_sink(cur_sink, sinks)       # someone picked a new base output meanwhile
    base = tv_sink(names) if c["mirror"] == "tv" else None
    out = hs
    if hs and base and base != hs:
        if Combo.up([base, hs]):
            out = COMBO
    else:
        Combo.down()
    st.update({"headset": hs, "mic": mic, "output": out, "tv": base})
    save(STATE, st)
    if out:
        ok("pactl", "set-default-sink", out)
        if ee_running():
            ok("gsettings", "set", EE_OUT, "output-device", out)
        set_ee_blocklist(bool(c["chat_only"] and hs and out == COMBO))
        n = move_sink_inputs(out, hs if c["chat_only"] and out == COMBO else None)
    else:
        n = 0
    if mic:
        ok("pactl", "set-default-source", mic)
    where = {COMBO: "TV + headset", hs: "headset"}.get(out, "unchanged")
    log(f"engaged ({why}): output {out or '-'}, mic {mic or '-'}, tv {base or '-'}, "
        f"chat-only {c['chat_only']}, {n} stream(s) moved")
    return where


def disengage(why="headset unplugged"):
    st = load(STATE, {})
    Combo.down()
    if not st.get("active"):
        return False
    set_ee_blocklist(False)
    st = load(STATE, {})
    sinks = pj("sinks")
    names = {s["name"] for s in sinks}
    target = st.get("sink") if st.get("sink") in names else (tv_sink(names) or None)
    if target:
        ok("pactl", "set-default-sink", target)
        if ee_running() and st.get("ee_output"):
            eo = st["ee_output"].strip("'")
            ok("gsettings", "set", EE_OUT, "output-device", eo if eo in names else target)
        move_sink_inputs(target)
    src = st.get("source")
    if src and src in {s["name"] for s in pj("sources")}:
        ok("pactl", "set-default-source", src)
    save(STATE, {k: v for k, v in st.items() if k == "ee_blocklist"})
    if not load(STATE, {}):
        STATE.unlink(missing_ok=True)
    log(f"disengaged ({why}): output {target or '-'}, mic {src or 'default'}")
    return True


def reconcile(reason="", force=False):
    c = cfg()
    hs, mic = headset_nodes()
    st = load(STATE, {})
    if c["auto"] and (hs or mic):
        want_tv = tv_sink({s["name"] for s in pj("sinks")}) if c["mirror"] == "tv" else None
        cur = sh("pactl", "get-default-sink").strip()
        changed = (force or not st.get("active") or st.get("headset") != hs or st.get("mic") != mic
                   or st.get("tv") != want_tv
                   # couch / `audio wow` put the TV back as default -> TV + headset again
                   or (st.get("output") == COMBO and cur == st.get("tv"))
                   or (st.get("output") == COMBO and (Combo.proc is None or Combo.proc.poll() is not None)))
        if changed:
            first = not st.get("active")
            where = engage(hs, mic, reason or "headset present")
            if first:
                notify(f"Sound: {where}. Mic: {'headset' if mic else 'unchanged'}.", "Headset connected")
    elif st.get("active"):
        disengage(reason or ("auto off" if not c["auto"] else "headset gone"))
        notify("Sound back to the TV / previous output, mic back to default.", "Headset removed")


def link_notice(prev):
    """One notification when the controller connects in a way that can't carry jack audio."""
    lk = link()
    key = lk["kind"] + ("" if lk["audio"] else "-noaudio")
    if lk["kind"] != prev and lk["kind"] != "none":
        log(f"controller link: {lk['why']}")
        seen = set(NOTIFIED.read_text().split()) if NOTIFIED.exists() else set()
        if not lk["audio"] and key not in seen:
            notify(lk["why"] + ". Game sound stays on the TV.", "Controller headset jack")
            NOTIFIED.parent.mkdir(parents=True, exist_ok=True)
            NOTIFIED.write_text(" ".join(sorted(seen | {key})) + "\n")
    return lk["kind"]


# ---- the service ---------------------------------------------------------------------------
KICK = []      # SIGHUP (config change, `apply`) -> re-check in the main loop, not in the handler


def watch():
    CONF.mkdir(parents=True, exist_ok=True)
    kill_orphans()
    if load(STATE, {}).get("active"):
        log("previous session state found — re-checking")
    signal.signal(signal.SIGTERM, lambda *_: (_shutdown(), sys.exit(0)))
    signal.signal(signal.SIGHUP, lambda *_: KICK.append("settings/apply"))
    lk = link_notice(None)
    reconcile("startup")
    last_link = time.monotonic()
    while True:
        p = subprocess.Popen(["pactl", "subscribe"], stdout=subprocess.PIPE, text=True, bufsize=1)
        pending, deadline = None, 0.0
        os.set_blocking(p.stdout.fileno(), False)
        while p.poll() is None:
            line = p.stdout.readline()
            if line:
                m = re.match(r"Event '(\w+)' on (sink|source|card|server)\b", line)
                if m and not (m.group(1) == "change" and m.group(2) in ("sink", "source")):
                    pending, deadline = f"{m.group(1)} {m.group(2)}", time.monotonic() + 0.7
                continue
            now = time.monotonic()
            if KICK:
                why = KICK.pop()
                KICK.clear()
                reconcile(why, force=True)
            if pending and now >= deadline:
                reconcile(pending)
                pending = None
            if now - last_link > 2:
                lk, last_link = link_notice(lk), now
            time.sleep(0.15)
        log("pactl subscribe ended — restarting in 2 s")
        time.sleep(2)


def _shutdown():
    if load(STATE, {}).get("active"):
        disengage("service stopping")
    Combo.down()


# ---- commands -------------------------------------------------------------------------------
def tone(path, notes, amp=0.2):
    rate, frames = 48000, bytearray()
    for hz, sec in notes:
        n = int(rate * sec)
        for i in range(n):
            env = min(1.0, i / 240, (n - i) / 240)
            s = int(amp * 32767 * env * math.sin(2 * math.pi * hz * i / rate)) if hz else 0
            frames.extend(s.to_bytes(2, "little", signed=True) * 2)
    with wave.open(path, "wb") as w:
        w.setnchannels(2), w.setsampwidth(2), w.setframerate(rate), w.writeframes(bytes(frames))


def cue(sink, notes):
    if not sink:
        return
    with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as f:
        path = f.name
    tone(path, notes)
    subprocess.run(["pw-play", "--target", sink, "-P", '{ application.name = "xbox-headset" }',
                    path], capture_output=True, timeout=10)
    os.unlink(path)


def status():
    c, st, lk = cfg(), load(STATE, {}), link()
    hs, mic = headset_nodes()
    print(f"Controller: {lk['why']}")
    if lk.get("driver"):
        print(f"  driver: {lk['driver']}   xone loaded: {'yes' if xone_loaded() else 'no'}")
    print(f"Headset output: {hs or 'not found'}")
    print(f"Headset mic:    {mic or 'not found'}")
    print(f"Settings: auto {'on' if c['auto'] else 'off'}, mirror {c['mirror']}, "
          f"chat-only {'on' if c['chat_only'] else 'off'}")
    if st.get("active"):
        print(f"Routing ACTIVE since {st.get('since')}: output {st.get('output')} "
              f"(TV {st.get('tv') or '-'}), mic {st.get('mic') or '-'}")
        print(f"  restores on unplug: output {st.get('sink')}, mic {st.get('source') or 'default'}")
    else:
        print("Routing: inactive (no controller headset)")
    print(f"Default output: {sh('pactl', 'get-default-sink').strip()}")
    src = sh("pactl", "get-default-source").strip()
    mute = sh("pactl", "get-source-mute", src).strip()
    print(f"Default mic:    {src}  ({mute.lower() or '?'})")
    svc = sh("systemctl", "--user", "is-active", "xbox-headset.service").strip()
    print(f"Service: xbox-headset.service {svc}")


def mute(arg):
    _, mic = headset_nodes()
    src = mic or sh("pactl", "get-default-source").strip()
    if arg in ("on", "off"):
        ok("pactl", "set-source-mute", src, "1" if arg == "on" else "0")
    else:
        ok("pactl", "set-source-mute", src, "toggle")
    muted = "yes" in sh("pactl", "get-source-mute", src).lower()
    hs, _ = headset_nodes()
    out = hs or sh("pactl", "get-default-sink").strip()
    # Xbox-like cue: falling two-tone = muted, rising = live
    cue(out, [(880, .09), (0, .04), (587, .14)] if muted else [(587, .09), (0, .04), (880, .14)])
    print(f"Mic {'MUTED' if muted else 'live'}: {src}")
    notify("Mic muted" if muted else "Mic live", "Headset mic")


def test():
    hs, mic = headset_nodes()
    st = load(STATE, {})
    if not hs and not mic:
        print("No controller headset found. " + link()["why"])
        return 1
    out = st.get("output") or hs
    print(f"1. Three beeps on {out}" + (" (TV and headset)" if out == COMBO else ""))
    cue(out, [(523, .25), (0, .1), (659, .25), (0, .1), (784, .35)])
    if mic:
        print(f"2. Speak into the headset mic for 3 seconds ({mic}) ...")
        with tempfile.TemporaryDirectory() as d:
            rec = Path(d) / "mic.wav"
            p = subprocess.Popen(["pw-record", "--target", mic, "--format", "s16", "--rate", "48000",
                                  "--channels", "1", "-P", '{ application.name = "xbox-headset" }',
                                  str(rec)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            time.sleep(3.2)
            p.terminate(); p.wait(3)
            peak = 0
            try:
                with wave.open(str(rec)) as w:
                    data = memoryview(w.readframes(w.getnframes())).cast("h")
                    peak = max((abs(x) for x in data), default=0)
            except (OSError, wave.Error, EOFError):
                pass
        db = 20 * math.log10(peak / 32768) if peak else float("-inf")
        print(f"   mic peak {db:.1f} dBFS — " + ("ok, the mic works" if db > -45 else
              "very quiet/silent: check the headset's own mute switch and `audio headset mute off`"))
    return 0


def set_cfg(key, value):
    c = cfg()
    c[key] = value
    save(CFG, c)
    kick_service()


def kick_service():
    """The service owns the combined output (it lives as long as the service), so changes go
    through it: SIGHUP = re-check now. Starts the service if it is not running."""
    pid = os.environ.get("XBOX_HEADSET_PID") or sh(
        "systemctl", "--user", "show", "-p", "MainPID", "--value", "xbox-headset.service").strip()
    if pid and pid != "0":
        os.kill(int(pid), signal.SIGHUP)
    elif not ok("systemctl", "--user", "start", "xbox-headset.service"):
        print("xbox-headset.service is not installed/running: systemctl --user enable --now "
              "xbox-headset")


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    arg = argv[2] if len(argv) > 2 else ""
    if cmd == "watch":
        watch()
    elif cmd == "status":
        status()
    elif cmd == "test":
        return test()
    elif cmd == "link":
        print(json.dumps(link()))
    elif cmd in ("chat-only", "chat") and arg in ("on", "off"):
        set_cfg("chat_only", arg == "on")
        print(f"chat-only {arg}: voice chat " + ("only in the headset, game on TV + headset"
                                                  if arg == "on" else "on TV + headset like the game"))
    elif cmd == "mirror" and arg in ("tv", "never"):
        set_cfg("mirror", arg)
        print(f"mirror {arg}")
    elif cmd == "auto" and arg in ("on", "off"):
        set_cfg("auto", arg == "on")
        print(f"automatic headset switching {arg}")
    elif cmd == "mute":
        mute(arg)
    elif cmd == "apply":
        kick_service()
    elif cmd == "active":
        return 0 if load(STATE, {}).get("active") else 1
    else:
        print(__doc__.split("\n\n")[2] if "\n\n" in __doc__ else __doc__)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
